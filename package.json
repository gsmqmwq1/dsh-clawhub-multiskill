{
  "name": "dsh-skills-market",
  "version": "1.1.0.1",
  "description": "DeepSeek Harness 原生 AI Agent 技能集市与多技能中文意图批量调度插件",
  "author": "gsmqmwq1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gsmqmwq1/dsh-skills-market.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0 || ^18.3.1"
  }
}
